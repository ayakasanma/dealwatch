# 複製成 .env 再填。.env 不會進版控，不要上傳或分享。

# --- LINE 推播（設定步驟見 README「LINE 推播」）---
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
# 只推給你自己：LINE Developers Console > Basic settings 最下方的 "Your user ID"（U 開頭 33 碼）。留空 = 廣播給所有好友
LINE_TO=

# --- 以下只有 Docker / NAS 部署會用到 ---

# 網頁介面和遠端瀏覽器畫面共用的密碼。開放給區域網路時務必設定。
UI_PASSWORD=
# 遠端瀏覽器畫面的登入帳號（網頁介面的帳號欄隨便填）
VIEW_USER=dealwatch

# NAS 對外的埠號
HOST_UI_PORT=8787
HOST_VIEW_PORT=3001

# 檔案擁有者。在 NAS 上用 SSH 執行 `id 你的帳號` 查；Synology 第一個管理員通常是 1026 / 100
PUID=1026
PGID=100

TZ=America/Chicago
